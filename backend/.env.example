# Скопируйте в .env (copy .env.example .env) и поправьте. Все значения необязательны:
# без файла .env сервер поднимется с настройками для разработки.

# --- Порт, на котором API доступен с вашего компьютера
API_PORT=3000

# --- База данных
POSTGRES_USER=krimfish
POSTGRES_PASSWORD=krimfish
POSTGRES_DB=krimfish
DB_PORT=5432

# --- Режим: development (по умолчанию) или production
NODE_ENV=development

# --- Секрет для подписи токенов. В production обязателен, не короче 32 символов.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Администраторы. Укажите свой email (несколько через запятую) и придумайте пароль (минимум 8 символов,
# в production минимум 12). При старте сервер сам создаст такие аккаунты с ролью ADMIN и этим паролем,
# войти можно в приложении по email и паролю. Через Google роль ADMIN получает тот же email, если Google подтвердил почту.
# Обычная регистрация на адрес из этого списка закрыта.
ADMIN_EMAILS=
ADMIN_PASSWORD=
# Имя администратора (записывается в аккаунты из ADMIN_EMAILS при каждом запуске сервера).
ADMIN_NAME=Админ

# --- Вход через Google. Web client ID из Google Cloud Console (OAuth «Веб-приложение»). Пусто = кнопки нет.
GOOGLE_CLIENT_ID=

# --- Вход через VK ID. ID приложения из кабинета VK ID. Пусто = кнопки нет.
# VK_REDIRECT_URI по умолчанию vk<ID>://vk.ru/blank.html; менять нужно, только если в кабинете VK указан другой.
VK_CLIENT_ID=
VK_REDIRECT_URI=

# --- Демо-данные при первом запуске (товары, слоты, промокод FISH10). В production по умолчанию false.
SEED_DEMO=true

# --- Доставка
APP_TZ=Europe/Moscow
DELIVERY_KOP=39000
SLOT_DAYS=2
SLOT_LEAD_HOURS=1

# --- Откуда разрешены запросы из браузера (Flutter web). * = откуда угодно, или список через запятую.
CORS_ORIGIN=*

# --- Фото товаров (S3-совместимое хранилище; локально это MinIO из docker-compose)
# S3_PUBLIC_URL — адрес хранилища так, как его видит телефон/браузер:
#   браузер или iOS-симулятор: http://localhost:9000
#   эмулятор Android:          http://10.0.2.2:9000
#   реальный телефон в Wi-Fi:  http://<IP-компьютера>:9000
#   production:                https://storage.yandexcloud.net (и свои ключи/бакет)
S3_PUBLIC_URL=http://localhost:9000
S3_PORT=9000
S3_BUCKET=krimfish
S3_ACCESS_KEY=krimfish
S3_SECRET_KEY=krimfish-secret

# --- Письма с кодом подтверждения почты ---
# console: код пишется в лог сервера и показывается в приложении (только для разработки).
# smtp: настоящая отправка. В production обязателен smtp.
MAIL_MODE=console
MAIL_FROM=Карасик <noreply@your-domain.ru>
# Пример для Яндекс 360 / Mail.ru / Gmail (пароль приложения): smtp.yandex.ru:465 ssl, smtp.gmail.com:465 ssl.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=ssl
SMTP_USER=
SMTP_PASSWORD=
